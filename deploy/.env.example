# Копируется на сервер как /etc/demotest/demotest.env (права 600, владелец www-data)
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
DATABASE_URL=postgres://demotest_user:STRONG_PASSWORD@localhost:5432/demotest
ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://odil-star.github.io,https://example.com
CSRF_TRUSTED_ORIGINS=https://odil-star.github.io,https://example.com
LOGIN_THROTTLE_RATE=10/min
